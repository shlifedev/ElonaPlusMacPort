{
  "version": 6,
  "configurePresets": [
    {
      "name": "macos-arm64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-macos-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-arm64-legacy-cp932-debug",
      "inherits": "macos-arm64-debug",
      "binaryDir": "${sourceDir}/build/native-macos-arm64-legacy-cp932-debug",
      "cacheVariables": {
        "ELONA_LEGACY_CP932": "ON",
        "ELONA_LEGACY_RNG": "ON"
      }
    },
    {
      "name": "windows-x64-legacy-cp932-debug",
      "inherits": "windows-x64-debug",
      "binaryDir": "${sourceDir}/build/native-windows-x64-legacy-cp932-debug",
      "cacheVariables": {
        "ELONA_LEGACY_CP932": "ON",
        "ELONA_LEGACY_RNG": "ON"
      }
    },
    {
      "name": "macos-arm64-legacy-cp932-release",
      "inherits": "macos-arm64-legacy-cp932-debug",
      "binaryDir": "${sourceDir}/build/native-macos-arm64-legacy-cp932-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ELONA_MACOS_PINNED_GUI": "ON",
        "ELONA_GUI": "ON",
        "ELONA_TEXT_TTF": "ON",
        "SDL3_DIR": "${sourceDir}/.cache/macos-gui/SDL3-3.4.20/SDL3.framework/Resources/CMake",
        "SDL3_ttf_DIR": "${sourceDir}/.cache/macos-gui/SDL3_ttf-3.2.2/SDL3_ttf.framework/Resources/CMake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug"
    },
    {
      "name": "macos-arm64-legacy-cp932-debug",
      "configurePreset": "macos-arm64-legacy-cp932-debug"
    },
    {
      "name": "windows-x64-legacy-cp932-debug",
      "configurePreset": "windows-x64-legacy-cp932-debug"
    },
    {
      "name": "macos-arm64-legacy-cp932-release",
      "configurePreset": "macos-arm64-legacy-cp932-release"
    }
  ],
  "testPresets": [
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-legacy-cp932-debug",
      "configurePreset": "macos-arm64-legacy-cp932-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-legacy-cp932-debug",
      "configurePreset": "windows-x64-legacy-cp932-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-legacy-cp932-release",
      "configurePreset": "macos-arm64-legacy-cp932-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
