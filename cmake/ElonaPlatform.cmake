# ElonaPlus platform layer: CP932 <-> UTF-8 and the game filesystem overlay.
# Usage from the root CMakeLists.txt (owned by the host integrator):
#   include(cmake/ElonaPlatform.cmake)
#   target_link_libraries(<host target> PRIVATE elona_platform)
#   # optional HSP file-event adapter (needs the HSP core include dirs):
#   target_link_libraries(<host target> PRIVATE elona_platform_hsp)
# Standalone tests: cmake -S tests/platform -B build/platform-tests
if(TARGET elona_platform)
  return()
endif()
get_filename_component(ELONA_PLATFORM_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(elona_platform STATIC
  "${ELONA_PLATFORM_ROOT}/src/platform/encoding.cpp"
  "${ELONA_PLATFORM_ROOT}/src/platform/game_files.cpp")
target_include_directories(elona_platform PUBLIC "${ELONA_PLATFORM_ROOT}/src")
target_compile_features(elona_platform PUBLIC cxx_std_17)
if(APPLE)
  find_library(ELONA_COREFOUNDATION CoreFoundation REQUIRED)
  find_library(ELONA_ICONV iconv)
  target_link_libraries(elona_platform PUBLIC ${ELONA_COREFOUNDATION})
  if(ELONA_ICONV)
    target_link_libraries(elona_platform PUBLIC ${ELONA_ICONV})
  endif()
elseif(WIN32)
  target_link_libraries(elona_platform PUBLIC normaliz)
  target_compile_definitions(elona_platform PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
else()
  find_package(Iconv)
  if(Iconv_FOUND)
    target_link_libraries(elona_platform PUBLIC Iconv::Iconv)
  endif()
endif()
if(MSVC)
  target_compile_options(elona_platform PRIVATE /utf-8 /W4)
else()
  target_compile_options(elona_platform PRIVATE -Wall -Wextra)
endif()

# HSP file-event adapter. Requires HSP3 core headers; ELONA_PLATFORM_HSP3_DIR
# defaults to the pinned OpenHSP checkout used by the root build.
if(NOT DEFINED ELONA_PLATFORM_HSP3_DIR)
  set(ELONA_PLATFORM_HSP3_DIR "${ELONA_PLATFORM_ROOT}/.cache/upstream/OpenHSP/src/hsp3")
endif()
if(EXISTS "${ELONA_PLATFORM_HSP3_DIR}/hsp3struct.h" AND EXISTS "${ELONA_PLATFORM_ROOT}/src/platform/game_files_hsp.cpp")
  add_library(elona_platform_hsp STATIC "${ELONA_PLATFORM_ROOT}/src/platform/game_files_hsp.cpp")
  target_include_directories(elona_platform_hsp PUBLIC "${ELONA_PLATFORM_ROOT}/src" "${ELONA_PLATFORM_HSP3_DIR}")
  target_link_libraries(elona_platform_hsp PUBLIC elona_platform)
  if(MSVC)
    target_compile_options(elona_platform_hsp PRIVATE /utf-8)
    target_compile_definitions(elona_platform_hsp PRIVATE HSPWIN HSPDEBUG HSP64 NOMINMAX _CRT_SECURE_NO_WARNINGS)
  elseif(APPLE)
    target_compile_definitions(elona_platform_hsp PRIVATE HSPMAC HSPDEBUG HSP64)
    target_compile_options(elona_platform_hsp PRIVATE -Wno-write-strings)
  else()
    target_compile_definitions(elona_platform_hsp PRIVATE HSPLINUX HSPDEBUG HSP64)
    target_compile_options(elona_platform_hsp PRIVATE -Wno-write-strings)
  endif()
endif()
