{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElonaPlus",
  "mainBinaryName": "ElonaPlus",
  "version": "0.1.0",
  "identifier": "io.github.shlifedev.elonaplus",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ElonaPlus",
        "width": 420,
        "height": 260,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "RolePlayingGame",
    "copyright": "Elona (c) Noa, ElonaPlus by Ano. Unofficial fan port."
  }
}
