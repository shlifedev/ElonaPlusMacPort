; Observation variant of tests/gui/pixel_roundtrip.hsp: same operations, but each
; stage is written with bmpsave so the runtime's own pixel bytes can be decoded.
screen 0,16,16
redraw 0
buffer 1,16,16
color 17,34,51
boxf 0,0,15,15
bmpsave "pr-buffer1-before.bmp"
gsel 0
pos 0,0
gmode 0
gcopy 1,0,0,16,16
bmpsave "pr-screen0.bmp"
gsel 1
color 0,0,0
boxf 0,0,15,15
pos 0,0
gcopy 0,0,0,16,16
bmpsave "pr-buffer1-after.bmp"
gsel 0
redraw 1
stop
