    }
  },
  {
    "id": "story.event.12.title",
    "source": "@event/12/title",
    "target": "《 반려동물과의 재회 》",
    "source_ref": [
      "2.335:start.hsp:614803"
    ],
    "speaker": "narrator",
    "match_kind": "scoped_exact",
    "review_status": "reviewed",
    "origin": {
