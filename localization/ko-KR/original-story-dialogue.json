    }
  },
  {
    "id": "story.event.38.title",
    "source": "@event/38/title",
    "target": "《 숨어 있던 누군가 》",
    "source_ref": [
      "2.335:start.hsp:614737"
    ],
    "speaker": "narrator",
    "match_kind": "scoped_exact",
    "review_status": "reviewed",
    "origin": {
