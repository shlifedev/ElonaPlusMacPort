    }
  },
  {
    "id": "story.named.373856",
    "source": "@home-name/373856",
    "target": "…그럼 다시 만날 때까지, {name}. 당신에게 바람의 가호가 함께하기를.",
    "source_ref": [
      "2.335:start.hsp:373856"
    ],
    "speaker": "Larnneire",
    "match_kind": "scoped_template",
    "review_status": "reviewed",
    "origin": {
