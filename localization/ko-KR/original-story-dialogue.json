    }
  },
  {
    "id": "story.event.12.body",
    "source": "@event/12/body",
    "target": "광산 마을로 향하던 당신은 낯익은 울음소리에 발걸음을 멈췄다. 난파 때 헤어진 반려동물이 반갑게 달려오고 있다! 당신의 반려동물은…….",
    "source_ref": [
      "2.335:start.hsp:614805"
    ],
    "speaker": "narrator",
    "match_kind": "scoped_exact",
    "review_status": "reviewed",
    "origin": {
