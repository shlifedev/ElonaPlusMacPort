  {
    "id": "book.31.JP.author",
    "source": "@book/31/ea3dc870e5e4a32e87e9f8858021cd997edd05f6279d2695d99a78df12711502/author",
    "target": "낚시 자랑꾼 피셔 지음",
    "source_ref": [
      "2.335:data/book.txt:4294-4295"
    ],
    "match_kind": "book_page",
    "review_status": "reviewed",
    "origin": {
      "kind": "independent-translation",
      "reference": "ElonaPlus 2.335 book 31 JP",
