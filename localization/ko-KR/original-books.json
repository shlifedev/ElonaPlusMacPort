  },
  {
    "id": "book.30.JP.author",
    "source": "@book/30/1602452f1d3f32b7c0dec312b6117d136b15c4cbb4b3a8cf8797ff4360b9e75a/author",
    "target": "걱정 많은 아버지 지음",
    "source_ref": [
      "2.335:data/book.txt:4057-4058"
    ],
    "match_kind": "book_page",
    "review_status": "reviewed",
    "origin": {
      "kind": "independent-translation",
      "reference": "ElonaPlus 2.335 book 30 JP",
      "source_hash": "201c92d0bccb4d18631944888b78f9290c0742f581560d776e53766b3717f37a"
