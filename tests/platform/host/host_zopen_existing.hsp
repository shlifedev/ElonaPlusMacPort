; z.hpi write after a notesave already materialised user\ in the user root.
#uselib "z.hpi"
#func zOpen "_zOpen@16" $5
#func zRead "_zRead@16" $1
#func zWrite "_zWrite@16" $1
#func zClose "_zClose@16" $0
exedir = dirinfo(1) + "\\"
sdim m, 8
m = "m"
notesel m
notesave exedir + "user\\materialize.txt"
dim d, 4
d = 11, -22, 0x7fffffff, 0x80000000
zOpen h, exedir + "user\\npc1.t", 1, 3
zWrite d, h, 16
zClose h
dim e, 4
zOpen h, exedir + "user\\npc1.t", 0
zRead e, h, 16
zClose h
sdim r, 256
r = "z=" + e(0) + "," + e(1) + "," + e(2) + "," + e(3) + "\n"
notesel r
notesave exedir + "user\\zopen_result.txt"
end 7
