  },
  {
    "source": "@log/ Welcome traveler! ",
    "target": "여행자여, 어서 오세요!",
    "source_ref": [
      "2.335:start.hsp:608874"
    ],
    "source_ja_note": "",
    "review_status": "reviewed",
    "origin": {
      "kind": "independent-translation",
